{
  "name": "365Bench",
  "dockerComposeFile": "docker-compose.yml",
  "service": "m365-bench",
  "workspaceFolder": "/workspace",
  "remoteUser": "${localEnv:USER}",
  "updateRemoteUserUID": false,
  "containerEnv": {
    "DOCKER_HOST": "unix:///var/run/docker.sock"
  },
  "initializeCommand": "bash ${localWorkspaceFolder}/../../scripts/prepare-bench-start.sh --container m365-bench --base m365-bench:latest --user ${localEnv:USER} --project sys-benches --service m365-bench",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.powershell",
        "microsoft-IsvExpTools.powerplatform-vscode",
        "ms-dynamics-smb.al",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "timonwong.shellcheck",
        "humao.rest-client",
        "ms-vscode-remote.remote-ssh",
        "github.copilot",
        "github.copilot-chat",
        "openai.chatgpt",
        "anthropic.claude-code",
        "Google.geminicodeassist",
        "eamodio.gitlens"
      ],
      "settings": {
        "al.enableCodeAnalysis": true,
        "al.enableCodeActions": true,
        "al.codeAnalyzers": [
          "${CodeCop}",
          "${UICop}"
        ],
        "al.useVsCodeAuthentication": true
      }
    }
  },
  "features": {}
}
