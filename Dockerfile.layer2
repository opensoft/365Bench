# Layer 2: Microsoft 365 Admin Bench Image
# Extends Layer 1b (sys-bench-base) with Microsoft 365 business-stack admin tools.
# Focus: M365 user/tenant administration (Entra ID, Exchange Online, Teams,
# SharePoint/OneDrive) — NOT Azure infrastructure / AKS.
# USER-AGNOSTIC: No user creation — Layer 3 handles user setup.

ARG BASE_IMAGE=sys-bench-base:latest
FROM ${BASE_IMAGE}

# Container version labels
LABEL layer="2"
LABEL layer.name="m365-bench"
LABEL layer.version="1.0.0"
LABEL layer.description="Microsoft 365 business-stack admin tools (user-agnostic)"
LABEL bench.type="m365-admin"

# Everything runs as root
USER root

# ========================================
# PREREQUISITES
# ========================================
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get -y install --no-install-recommends \
    ca-certificates \
    curl \
    wget \
    unzip \
    gnupg \
    apt-transport-https \
    software-properties-common \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ========================================
# MICROSOFT 365 ADMIN TOOLS (minimal core set)
# ========================================
COPY install-365-tools-minimal.sh /tmp/
RUN bash /tmp/install-365-tools-minimal.sh && rm /tmp/install-365-tools-minimal.sh

# ========================================
# SHELL CONFIGURATION (into /etc/skel)
# ========================================
# Layer 3's `useradd -m` copies /etc/skel into the user's home, so aliases are
# user-agnostic (no hardcoded usernames, nothing under /root).
RUN echo '' >> /etc/skel/.zshrc && \
    echo '# Microsoft 365 admin aliases' >> /etc/skel/.zshrc && \
    echo 'alias m365login="m365 login"' >> /etc/skel/.zshrc && \
    echo 'alias graphconnect="pwsh -NoLogo -Command Connect-MgGraph"' >> /etc/skel/.zshrc

# Default command
CMD ["sleep", "infinity"]
